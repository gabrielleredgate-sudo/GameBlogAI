@using GameBlog.Models.DBModels
@model List<blogpost>

@{
    ViewBag.Title = "Blog";
}
<script src="~/js/blog.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Plotly CDN -->
<script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
<script src="~/js/blogtrend.js"></script>

<button id="showModalButton" class="btn btn-primary">New Blog</button>
<div class="blog-list">
    <h1>Latest Blog Posts</h1>
    <hr />

    @foreach (var post in Model)
    {
        <div class="blog-summary">
            <h2>
               @post.title
            </h2>
            <p class="meta">
                 <em>@post.PostDate.ToString("MMMM dd, yyyy")</em>
            </p>

            <p>
                @if (!string.IsNullOrEmpty(post.post))
                {<div>
                        @post.post</div>
                }
                else
                {
                    <div>No post found</div>
                }
            </p>

        </div>
        <hr />
    }
</div>



<div id="chart"></div>



<div id="myModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Blog</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-control-label">Title</label>
                    <input class="form-control" autocomplete="off" type="text" id="newTitle" />
                </div>
                <div class="form-group">
                    <label class="form-control-label">Blog</label>
                    <textarea class="form-control custom-textarea" id="newBlogBody" rows="12" placeholder="Blog here..."></textarea>
                </div>

                <div class="form-group">
                    <label class="form-control-label">AI Suggestion</label>
                    <textarea class="form-control custom-textarea" id="newAIBody" rows="12" placeholder="AI processing..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="aiSuggestionBtn" class="btn btn-primary">AI Suggestion</button>
                <button type="button" id="submitBlogBtn" class="btn btn-primary">Add</button>
            </div>
        </div>
    </div>
</div>