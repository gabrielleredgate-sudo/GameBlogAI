@using GameBlog.Models.DBModels
@model List<blogpost>

@{
    ViewBag.Title = "Blog";
}

<div class="blog-list">
    <h1>Latest Blog Posts</h1>
    <hr />

    @foreach (var post in Model)
    {
        <div class="blog-summary">
            <h2>
               @post.title
            </h2>
            <p class="meta">
                 <em>@post.PostDate.ToString("MMMM dd, yyyy")</em>
            </p>

            <p>
                @if (!string.IsNullOrEmpty(post.post))
                {<div>
                        @post.post</div>
                }
                else
                {
                    <div>No post found</div>
                }
            </p>

        </div>
        <hr />
    }
</div>